{
  "manifest_version": 3,
  "name": "PR Watcher",
  "version": "0.1.0",
  "description": "GitHub の自分の PR とレビュー依頼をツールバーから確認する",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PR Watcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "alarms",
    "idle",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*"
  ]
}
